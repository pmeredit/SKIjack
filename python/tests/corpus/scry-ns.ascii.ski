-- EXAMPLES.md section 5: a value lookup, compiled and run.
-- Typed paths: `/nat/three` is `Cons Nat (Cons Three Nil)`; inside < >
-- the path's own constructors are level-0 names, so they are inlined and
-- quoted, and `?^` wraps the result in the object type's `Scry` leaf.
term5 === S | K | I | App term5 term5 | Scry
seg === Nat | Two | Three
path === Nil | Cons seg path
bool === PTrue | PFalse

oanswer === OJust term5 | ONothing | ONotYet
outcome === SteppedN term5 | DoneN | ErrdN | PendingN path
result === RValN term5 | RErrN | RTimeN | RBlockN path

-- structural equality on encoded paths: the paper's EQ5
pAnd p q = p q PFalse
pKKF = K (K PFalse)
eqApp2P e t u t2 u2 = pAnd (e t t2) (e u u2)
eqApp1P e n t u = n PFalse PFalse PFalse (eqApp2P e t u) PFalse
-- parentheses hide newlines, so a long body may be wrapped
eqNP e m n = (m (n PTrue  PFalse PFalse pKKF PFalse)
                (n PFalse PTrue  PFalse pKKF PFalse)
                (n PFalse PFalse PTrue  pKKF PFalse)
                (eqApp1P e n)
                (n PFalse PFalse PFalse pKKF PTrue))
EQ5 m = eqNP EQ5 m

scHitN rest v = SteppedN (rb v rest)

wfN e := {
  stepScry1 p rest = e p (scHitN rest) ErrdN (PendingN p)
  stepScry args    = args DoneN (stepScry1 e)
}

resolve := ns{/nat/two => <I>, /nat/three => <K>}

prog    := <?^/nat/three>
answer  := wfN resolve |- <?^/nat/three>@10
answer2 := wfN resolve |- <?^/nat/two>@10
