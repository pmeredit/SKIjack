-- The paper's scry interpreter: {S,K,I,App,Scry} with a resolver.
-- `Scry` is a *leaf* of arity 0, so `Scry p` is ordinary application and
-- becomes a redex once it has its one argument.
-- The core takes the resolver as a parameter, which is how it enters:
-- `wfQ E |- <t>@n` compiles to `loop E n <t>`.
term5 === S | K | I | App term5 term5 | Scry
maybe === Nothing | Just term5
outcome === Stepped term5 | Done | Errd
result === RVal term5 | RErr | RTime

-- shared by every resolver-taking interpreter: splice the answer in as
-- the new head and carry on
scHit rest v = Stepped (rb v rest)

wfQ e := {
  stepScry1 p rest = e p Errd (scHit rest)
  stepScry args    = args Done (stepScry1 e)
}

-- the paper's three test resolvers, in the surface
encI := <I>
oracleAlways p = Just p
oracleNever  p = Nothing
oracleIfKk acc = Just encI
oracleIfK p = sp p nil (K Nothing) oracleIfKk (K Nothing) (K Nothing)

omega = S I I (S I I)

-- the paper's scry table, as level-1 declarations
qBase    := wfQ oracleAlways |- <I K>@3
qBaseN   := wfQ oracleNever  |- <I K>@3
qHit     := wfQ oracleAlways |- <I (Scry K)>@10
qMiss    := wfQ oracleNever  |- <I (Scry K)>@10
qBareN   := wfQ oracleNever  |- <Scry K>@10
qBareA   := wfQ oracleAlways |- <Scry K>@10
qUnsat   := wfQ oracleAlways |- <Scry>@10
qLazy    := wfQ oracleNever  |- <K K (Scry K)>@10
qIfKhit  := wfQ oracleIfK    |- <Scry K>@10
qIfKmiss := wfQ oracleIfK    |- <Scry (S K K)>@10
qOmega   := wfQ oracleAlways |- <S I I (S I I)>@5
