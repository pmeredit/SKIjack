-- Forms the EXAMPLES corpus does not exercise: signatures, wings,
-- lambdas, the Tier 1 glyph names, deeper axes, a payload-carrying path,
-- and the two arrows side by side: '->' is the signature arrow and
-- '=>' the fact arrow (SYNTAX.md section 2).
succ : nat -> nat
compose f g x = B f g x
dup w = W w
fix g = Y g
same a b = EQ a b
deep c = 6@c
lam h = \z.h z
wing r = r.a.b
peek s = ?^/vane/care[<K>]/desk s
facts := ns{/a/b => <I>, /a/c => <K>}
