-- A character table as a namespace: the first stage of a parser.
-- Each source character resolves to the term it denotes; lookup is
-- demand-driven, so only the characters the reduction needs are read.
-- Typed paths: `/src/ess` is `Cons Src (Cons Ess Nil)`; inside < > the
-- path's own constructors are level-0 names, so they are inlined and
-- quoted, and `?^` wraps the result in the object type's `Scry` leaf.
term5 === S | K | I | App term5 term5 | Scry
seg === Src | Ess | Kay | Eye
path === Nil | Cons seg path
bool === PTrue | PFalse

oanswer === OJust term5 | ONothing | ONotYet
outcome === SteppedN term5 | DoneN | ErrdN | PendingN term5
result === RValN term5 | RErrN | RTimeN | RBlockN term5

-- structural equality on encoded paths: the paper's EQ5
pAnd p q = p q PFalse
pKKF = K (K PFalse)
eqApp2P e t u t2 u2 = pAnd (e t t2) (e u u2)
eqApp1P e n t u = n PFalse PFalse PFalse (eqApp2P e t u) PFalse
-- parentheses hide newlines, so a long body may be wrapped
eqNP e m n = (m (n PTrue  PFalse PFalse pKKF PFalse)
                (n PFalse PTrue  PFalse pKKF PFalse)
                (n PFalse PFalse PTrue  pKKF PFalse)
                (eqApp1P e n)
                (n PFalse PFalse PFalse pKKF PTrue))
EQ5 m = eqNP EQ5 m

scHitN rest v = SteppedN (rb v rest)

wfN e := {
  stepScry1 p rest = e p (scHitN rest) ErrdN (PendingN p)
  stepScry args    = args DoneN (stepScry1 e)
}

chars := ns{/src/ess => <S>, /src/kay => <K>, /src/eye => <I>}

-- one lookup, in head position
one   := wfN chars |- <?^/src/ess>@10
-- two lookups, both demanded: I applied to S
apply := wfN chars |- <?^/src/eye ?^/src/ess>@20
-- three written, one discarded: K S I keeps S and never reads /src/eye
disc  := wfN chars |- <?^/src/kay ?^/src/ess ?^/src/eye>@40
-- three written, two unforced: S with two arguments is already WHNF
held  := wfN chars |- <?^/src/ess ?^/src/kay ?^/src/eye>@50
